# Nunca coloque credenciais reais neste arquivo.
# Configure as variáveis no terminal/ambiente de execução.
MONGODB_URI=mongodb+srv://USUARIO:SENHA_CODIFICADA@CLUSTER.mongodb.net/juris_home_auth?retryWrites=true&w=majority
COOKIE_SECURE=false
UI_THEME=juris

# O usuário administrador inicial só é criado quando as três variáveis estão definidas.
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=troque-por-uma-senha-forte-com-12-ou-mais-caracteres
